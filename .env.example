DB_HOST=db
MYSQL_DATABASE=cbc
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Required — the app will now refuse to start without this (no more unsafe
# built-in default). Generate a real one with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# Comma-separated list of origins allowed to call the API / open a WebSocket
# connection. Use your real frontend origin(s) in production — never "*".
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

EXECUTION_CONTAINER_PATH=/app/temp
# Set this to the absolute path of the temp/ folder on your HOST machine (use forward slashes on Windows too)
# Example on Linux/Mac: EXECUTION_HOST_PATH=/home/youruser/projects/cbc/temp
# Example on Windows:   EXECUTION_HOST_PATH=C:/Users/YourName/projects/cbc/temp
EXECUTION_HOST_PATH=/path/to/your/cbc/temp

